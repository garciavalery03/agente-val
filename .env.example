# ===========================================================================
# .env.example — variables de entorno del Agente_Val
# ===========================================================================
# Cómo usarlo:
#   1. Copia este archivo a   .env   (en la misma carpeta).
#   2. Rellena los valores reales.
#   3. NUNCA subas el .env al repo (ya está ignorado en .gitignore).
#
# config.py lee este archivo al arrancar. Lo que esté en el entorno del
# sistema tiene prioridad sobre lo que pongas aquí.
# ===========================================================================

# --- Identidad del agente --------------------------------------------------
# Nombre con el que el agente se presenta y firma los correos.
AGENTE_NOMBRE=Agente_Val

# --- Canal de correo -------------------------------------------------------
# Elige UNO:  "smtp"  (smtplib estándar)  |  "resend"  (API, recomendado)
CANAL_CORREO=smtp

# Remitente y destinatario por defecto del reporte de etiquetas.
CORREO_DE=tu_correo@ejemplo.com
CORREO_PARA=destinatario@ejemplo.com
CORREO_ASUNTO_PREFIJO=[Agente_Val]

# --- Opción A · SMTP (si CANAL_CORREO=smtp) --------------------------------
# Gmail:           SMTP_HOST=smtp.gmail.com        SMTP_PORT=587
# Outlook/Hotmail: SMTP_HOST=smtp.office365.com    SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=tu_correo@gmail.com
# OJO (Gmail): NO es tu contraseña normal. Activa la verificación en 2 pasos
# y genera una "App Password" de 16 caracteres -> pégala aquí sin espacios.
SMTP_PASSWORD=pon-aqui-tu-app-password

# --- Opción B · Resend (si CANAL_CORREO=resend) ----------------------------
# Crea una cuenta en resend.com, verifica un remitente y copia la API key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Red de agentes de la clase (MCP uthAgentes) — Componente 6 ------------
# Token compartido del servidor MCP de la clase. Te lo da el instructor.
# Se lee desde AQUÍ: el .mcp.json usa un headersHelper (tools/mcp_headers.cmd)
# que toma este valor del .env y arma el header Authorization. Solo pégalo aquí
# y reabre Claude Code; no hace falta setx ni variables del sistema.
# UTHAGENTES_TOKEN=el-token-del-instructor
